// Revenue Expense Tracker — database schema
//
// Production (Vercel): PostgreSQL, e.g. Neon (https://neon.tech) — Vercel's
// recommended serverless-friendly Postgres provider. `url` should be Neon's
// *pooled* connection string (via PgBouncer) since serverless functions can
// open many concurrent short-lived connections; `directUrl` should be the
// *unpooled* connection string, used only for running migrations.
//
// Local development: this same schema works with SQLite by temporarily
// setting `provider = "sqlite"` and `url = env("DATABASE_URL")` (see
// backend/.env.example) — no `directUrl` needed for SQLite.
//
// String "enum-like" fields are validated in the application layer (see
// src/lib/constants.ts) rather than as native Prisma enums, which keeps the
// schema portable between SQLite and PostgreSQL.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local development; "rhel-openssl-3.0.x" is required for
  // Vercel's Node.js serverless runtime (Amazon Linux 2023 + OpenSSL 3).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// People & households
// ---------------------------------------------------------------------------

/// A household is one "portfolio": a separate set of accounts, transactions,
/// properties, investments, bills… A person can belong to several (e.g. their
/// own finances plus a company and a trust) via PortfolioMember.
model Household {
  id            String   @id @default(cuid())
  name          String
  portfolioType String   @default("PERSONAL") // PERSONAL | COMPANY | TRUST | OTHER
  /// false only between registering and finishing the setup page; lets the setup
  /// page choose the type of a brand-new portfolio but never re-type an established one.
  setupComplete Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members          User[]
  portfolioMembers PortfolioMember[]
  businessProfile  BusinessProfile?
  ledgerAccounts   LedgerAccount[]
  businessEntries  BusinessEntry[]
  journalEntries   JournalEntry[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  properties    Property[]
  investments   Investment[]
  bills         Bill[]
  reminders     Reminder[]
  documents     Document[]
  capitalGainDisposals CapitalGainDisposal[]
  sourcingRecords SourcingRecord[]
  sourcingProducts SourcingProduct[]
  contacts      Contact[]
  holidayPlans  HolidayPlan[]
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  householdId     String?
  household       Household? @relation(fields: [householdId], references: [id])
  householdRole   String   @default("PRIMARY") // PRIMARY | PARTNER
  easyViewEnabled Boolean  @default(false)
  timezone        String   @default("Australia/Melbourne")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  portfolios         PortfolioMember[]
  transactions       Transaction[]
  propertyOwnerships PropertyOwnership[]
  notifications      Notification[]
  passwordResets     PasswordResetToken[]

  @@index([householdId])
}

/// Which portfolios (households) a person can open. `User.householdId` is their
/// default one; this table lists all of them, including the default.
model PortfolioMember {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role        String    @default("PRIMARY") // PRIMARY | PARTNER
  createdAt   DateTime  @default(now())

  @@unique([userId, householdId])
  @@index([householdId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Money: accounts, categories, transactions
// ---------------------------------------------------------------------------

model Account {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  type        String   // BANK | OFFSET | CREDIT_CARD | CASH | OTHER
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  bills        Bill[]

  @@index([householdId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  direction   String   // INCOME | EXPENSE
  isCustom    Boolean  @default(false)
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])
  createdAt   DateTime @default(now())

  transactions  Transaction[]
  bills         Bill[]
  scheduleLines PropertyScheduleLine[]

  @@index([householdId])
}

model Transaction {
  id                   String   @id @default(cuid())
  householdId          String
  household            Household @relation(fields: [householdId], references: [id])
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  date                 DateTime
  description          String
  amount               Float    // always positive; direction determines sign
  direction            String   // INCOME | EXPENSE
  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id])
  accountId            String?
  account              Account? @relation(fields: [accountId], references: [id])
  propertyId           String?
  property             Property? @relation(fields: [propertyId], references: [id])
  investmentId         String?
  investment           Investment? @relation(fields: [investmentId], references: [id])
  notes                String?
  isRecurring          Boolean  @default(false)
  recurrenceFrequency  String?  // WEEKLY | FORTNIGHTLY | MONTHLY | QUARTERLY | HALF_YEARLY | ANNUALLY | CUSTOM
  potentialTaxCategory String?  // suggestion only — never a determination
  financialYear        String   // e.g. "2026-27"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  documents Document[]
  reminders Reminder[]

  @@index([householdId])
  @@index([userId])
  @@index([date])
  @@index([financialYear])
  @@index([categoryId])
  @@index([propertyId])
  @@index([investmentId])
}

// ---------------------------------------------------------------------------
// Property investment
// ---------------------------------------------------------------------------

model Property {
  id                     String   @id @default(cuid())
  householdId            String
  household              Household @relation(fields: [householdId], references: [id])
  name                   String
  address                String?
  propertyType           String   @default("INVESTMENT") // INVESTMENT | PPR (principal place of residence)
  purchaseDate           DateTime?
  purchasePrice          Float?
  currentEstimatedValue  Float?
  loanBalance            Float?
  loanInterestRate       Float?
  rentalAgent            String?
  tenantName             String?
  rentAmount             Float?
  rentFrequency          String?  // WEEKLY | FORTNIGHTLY | MONTHLY
  rentalStartDate        DateTime?
  availableForRentDate   DateTime? // date the property was first genuinely available for rent
  // Property manager / managing agent
  managerName            String?
  managerCompany         String?
  managerEmail           String?
  managerPhone           String?   // office phone
  managerMobile          String?
  managerWebsite         String?
  managerAbn             String?   // 11 digits, no spaces
  managerAddress         String?   // office address
  managerNotes           String?
  scheduleInitialised    Boolean  @default(false) // default rental-schedule lines have been added
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  owners        PropertyOwnership[]
  transactions  Transaction[]
  bills         Bill[]
  documents     Document[]
  scheduleLines PropertyScheduleLine[]
  yearDetails   PropertyYearDetail[]
  photos        PropertyPhoto[]

  @@index([householdId])
}

model PropertyOwnership {
  id         String @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  percentage Float    // 0-100

  @@unique([propertyId, userId])
}

/// One row of a property's rental income & expenses schedule. Each line points
/// at a category, so transactions recorded against the property in that
/// category roll up into the line. The list is configurable per property:
/// lines can be added or removed at any time (removing a line never deletes
/// transactions).
model PropertyScheduleLine {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  label      String?  // display name; falls back to the category name
  isManual   Boolean  @default(false) // amount is worked out elsewhere (e.g. depreciation schedule) and entered by hand
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([propertyId, categoryId])
  @@index([propertyId])
}

/// A picture of a property. The image files live in Vercel Blob; the app only ever
/// serves them back through an authenticated route, never the raw storage URL.
model PropertyPhoto {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String   // image/jpeg | image/png | image/webp (checked from the file's own bytes)
  filePath    String   // blob URL of the full-size image
  thumbPath   String?  // blob URL of a small version, when the browser made one
  isPrimary   Boolean  @default(false) // the picture shown as the property's icon
  createdAt   DateTime @default(now())

  @@index([propertyId])
}

/// Per-financial-year rental facts for a property.
model PropertyYearDetail {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  financialYear String   // e.g. "2026-27"
  weeksRented   Int?
  updatedAt     DateTime @updatedAt

  @@unique([propertyId, financialYear])
}

// ---------------------------------------------------------------------------
// Shares, ETFs & other investments
// ---------------------------------------------------------------------------

model Investment {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  ticker      String?
  type        String   // SHARE | ETF | LIC | MANAGED_FUND | BOND | TERM_DEPOSIT | CRYPTO | P2P | PRIVATE | COLLECTIBLE | OTHER
  notes       String?
  currentValueOverride Float? // manual override for hard-to-price assets
  /// Where a share/ETF is traded: ASX (Australian) or WALL_ST (US). Empty for older records, which are treated as ASX.
  market      String?
  /// Currency the price is quoted in: AUD or USD.
  currency    String   @default("AUD")
  /// Persisted live market price for a share/ETF/LIC (per unit, in `currency`), refreshed from the
  /// market-data provider only while that security's exchange is open (see lib/marketHours.ts and
  /// services/marketPriceRefresh.ts). Null until the first successful refresh.
  marketPrice                  Float?
  /// When this server last wrote a *successful* provider price to `marketPrice` above. This is the
  /// timestamp shown to the user ("As at ...") — a failed refresh never changes it.
  marketPriceUpdatedAt         DateTime?
  /// The provider's own quote timestamp for that same price (e.g. Yahoo's regularMarketTime), kept
  /// separately since it can differ slightly from marketPriceUpdatedAt (provider/quote latency).
  marketPriceProviderTimestamp DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  valuations             InvestmentValuation[]
  investmentTransactions InvestmentTransaction[]
  dividends              Dividend[]
  transactions           Transaction[]
  documents              Document[]
  capitalGainDisposals   CapitalGainDisposal[]

  @@index([householdId])
}

/// A dated snapshot of a holding: how many units, at what price, worth how much. Imported from a broker
/// statement (e.g. Stake) or entered by hand. The newest snapshot is the holding's current value.
model InvestmentValuation {
  id             String     @id @default(cuid())
  investmentId   String
  investment     Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  asAt           DateTime   // statement date
  units          Float
  marketPrice    Float      // per unit, in `currency`
  marketValue    Float      // in `currency`
  marketValueAud Float      // in Australian dollars
  currency       String     @default("AUD")
  source         String     @default("MANUAL") // STAKE | MANUAL
  createdAt      DateTime   @default(now())

  @@unique([investmentId, asAt])
  @@index([investmentId])
}

model InvestmentTransaction {
  id           String   @id @default(cuid())
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id])
  type         String   // BUY | SELL
  date         DateTime
  quantity     Float
  pricePerUnit Float
  brokerage    Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([investmentId])
  @@index([date])
}

model Dividend {
  id              String   @id @default(cuid())
  investmentId    String
  investment      Investment @relation(fields: [investmentId], references: [id])
  exDividendDate  DateTime?
  paymentDate     DateTime?
  grossAmount     Float
  frankingCredit  Float    @default(0)
  frankedAmount   Float    @default(0)
  unfrankedAmount Float    @default(0)
  taxWithheld     Float    @default(0)
  netAmount       Float
  status          String   @default("EXPECTED") // EXPECTED | RECEIVED
  notes           String?
  financialYear   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents Document[]

  @@index([investmentId])
  @@index([financialYear])
}

/// A manually recorded capital gains disposal — for assets not tracked via
/// InvestmentTransaction buy/sell rows (e.g. a private sale, a collectible,
/// or a holding bought before you started using this app). Persisted so it
/// shows up in the Capital Gains report and tax summary alongside disposals
/// calculated automatically from buy/sell history.
model CapitalGainDisposal {
  id                  String   @id @default(cuid())
  householdId         String
  household           Household @relation(fields: [householdId], references: [id])
  investmentId        String
  investment          Investment @relation(fields: [investmentId], references: [id])
  purchaseDate        DateTime
  purchasePrice       Float
  purchaseCosts       Float    @default(0)
  saleDate            DateTime
  salePrice           Float
  saleCosts           Float    @default(0)
  quantity            Float
  ownershipPercentage Float    @default(100)
  costBase            Float
  proceeds            Float
  grossGainLoss       Float
  holdingPeriodDays   Int
  financialYear       String
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  documents Document[]

  @@index([householdId])
  @@index([investmentId])
  @@index([financialYear])
}

// ---------------------------------------------------------------------------
// Bills & reminders
// ---------------------------------------------------------------------------

model Bill {
  id                 String   @id @default(cuid())
  householdId        String
  household          Household @relation(fields: [householdId], references: [id])
  name               String
  provider           String?
  amount             Float
  frequency          String   // WEEKLY | FORTNIGHTLY | MONTHLY | QUARTERLY | HALF_YEARLY | ANNUALLY | CUSTOM
  nextDueDate        DateTime
  accountId          String?
  account            Account? @relation(fields: [accountId], references: [id])
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])
  propertyId         String?
  property           Property? @relation(fields: [propertyId], references: [id])
  autoRenew          Boolean  @default(false)
  reminderDaysBefore Int      @default(7)
  status             String   @default("UPCOMING") // UPCOMING | PAID | OVERDUE
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reminders Reminder[]

  @@index([householdId])
  @@index([nextDueDate])
}

model Reminder {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  billId      String?
  bill        Bill?    @relation(fields: [billId], references: [id])
  dividendId  String?
  /// Set for reminders created automatically from an expense dated in the future.
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  daysBefore  Int
  status      String   @default("PENDING") // PENDING | SNOOZED | COMPLETE | DISABLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([householdId])
  @@index([dueDate])
  @@index([transactionId])
}

// ---------------------------------------------------------------------------
// Documents & notifications
// ---------------------------------------------------------------------------

model Document {
  id            String   @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  fileName      String
  fileType      String
  filePath      String
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id])
  investmentId  String?
  investment    Investment? @relation(fields: [investmentId], references: [id])
  dividendId    String?
  dividend      Dividend? @relation(fields: [dividendId], references: [id])
  capitalGainDisposalId String?
  capitalGainDisposal   CapitalGainDisposal? @relation(fields: [capitalGainDisposalId], references: [id])
  sourcingRecordId String?
  sourcingRecord   SourcingRecord? @relation(fields: [sourcingRecordId], references: [id])
  /// Optional: when this document is a supplier invoice (or similar) for one specific payment
  /// or shipment on a sourcing order, rather than the order in general. Independent of
  /// sourcingRecordId above (a document attached this way is still set to belong to the order
  /// too, so it also appears in the order's overall Documents list).
  sourcingPaymentId String?
  sourcingPayment   SourcingPayment? @relation(fields: [sourcingPaymentId], references: [id])
  sourcingShipmentId String?
  sourcingShipment   SourcingShipment? @relation(fields: [sourcingShipmentId], references: [id])
  createdAt     DateTime @default(now())

  @@index([householdId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Small-business accounting (Company Finance portfolios)
//
// A double-entry ledger. Sales and expenses are entered as simple documents and
// posted to the ledger automatically, so the income statement, balance sheet
// and other reports always agree. All money in this section is stored as whole
// cents (Int) so nothing is ever lost to floating-point rounding.
// ---------------------------------------------------------------------------

model BusinessProfile {
  id            String    @id @default(cuid())
  householdId   String    @unique
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  businessName  String
  abn           String?
  entityType    String    @default("COMPANY") // COMPANY | SOLE_TRADER | PARTNERSHIP | TRUST
  gstRegistered Boolean   @default(false)
  gstBasis      String    @default("ACCRUAL") // ACCRUAL | CASH — how the GST (BAS) report is worked out
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// The chart of accounts.
model LedgerAccount {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  code        String
  name        String
  type        String    // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  group       String    // CURRENT_ASSET | NON_CURRENT_ASSET | CURRENT_LIABILITY | NON_CURRENT_LIABILITY | EQUITY | REVENUE | COST_OF_SALES | OTHER_INCOME | OPERATING_EXPENSE
  systemKey   String?   // ACCOUNTS_RECEIVABLE | ACCOUNTS_PAYABLE | GST_COLLECTED | GST_PAID | RETAINED_EARNINGS — accounts the app posts to itself
  isBank      Boolean   @default(false) // money accounts (bank, cash, credit card) that entries can be paid from/to
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  lines         JournalLine[]
  entries       BusinessEntry[] @relation("EntryAccount")
  paidEntries   BusinessEntry[] @relation("EntryBank")
  sourcingPayments SourcingPayment[]

  @@unique([householdId, code])
  @@unique([householdId, systemKey])
  @@index([householdId])
}

/// A sale/invoice (INCOME) or a bill/expense (EXPENSE), from which ledger journals are posted.
model BusinessEntry {
  id            String    @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  kind          String    // INCOME | EXPENSE
  date          DateTime
  dueDate       DateTime?
  description   String
  contactName   String?   // customer or supplier, as typed (kept for history; contactId is the link to the Contacts book)
  contactId     String?   // the customer/supplier in Contacts, when one was picked
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  reference     String?   // invoice / bill number
  accountId     String    // income or expense (or fixed-asset) account
  account       LedgerAccount @relation("EntryAccount", fields: [accountId], references: [id])
  totalCents    Int       // including GST
  gstCents      Int
  gstMode       String    @default("INCLUSIVE") // INCLUSIVE | EXCLUSIVE | FREE — how the amount was entered
  status        String    @default("PAID") // PAID | UNPAID
  paidDate      DateTime?
  bankAccountId String?
  bankAccount   LedgerAccount? @relation("EntryBank", fields: [bankAccountId], references: [id])
  notes         String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([householdId, date])
  @@index([householdId, kind, status])
  @@index([contactId])
}

model JournalEntry {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  date        DateTime
  description String
  reference   String?
  source      String    // ENTRY (posted from a sale/expense) | PAYMENT | MANUAL
  sourceId    String?   // the BusinessEntry it came from, if any
  createdById String
  createdAt   DateTime  @default(now())

  lines JournalLine[]

  @@index([householdId, date])
  @@index([sourceId])
}

model JournalLine {
  id          String        @id @default(cuid())
  entryId     String
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  debitCents  Int           @default(0)
  creditCents Int           @default(0)
  memo        String?

  @@index([entryId])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Sourcing (Company Finance): purchases from overseas and local manufacturers
// and suppliers. Kept as its own record — separate from BusinessEntry — because
// a sourcing order has a lot more shape than a single bill: it's placed with a
// supplier, often paid in stages and in a foreign currency, may go through a
// quality inspection, and has its own shipping/customs costs before it lands.
// Money here is stored as whole cents (Int), in the record's own `currency`,
// following the same convention as the rest of Company Finance.
// ---------------------------------------------------------------------------

/// A purchase / sourcing order from a manufacturer or supplier, overseas or local.
/// A product / SKU — the parent of its sourcing orders (one product, many orders). Product-level facts
/// live here once rather than being repeated on every order. The optional picture belongs to the product:
/// the file lives in Vercel Blob and is only ever served back through an authenticated route.
model SourcingProduct {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  sku         String?   // unique within a household when set (several products may have no SKU)
  description String?

  imageFileName    String?
  imageContentType String?   // image/jpeg | image/png | image/webp (checked from the file's own bytes)
  imagePath        String?   // blob URL of the full-size image
  imageThumbPath   String?   // blob URL of a small version, when the browser made one
  imageUpdatedAt   DateTime? // changes whenever the picture is added or replaced (used to refresh cached thumbnails)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders SourcingRecord[]

  @@unique([householdId, sku])
  @@index([householdId])
}

model SourcingRecord {
  id                String    @id @default(cuid())
  householdId       String
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// The product/SKU this order is for. Nullable only so existing orders survive the column being added —
  /// they are linked to a product by the backfill (services/business/products.ts), which is safe to repeat.
  productId         String?
  product           SourcingProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)
  origin            String    // OVERSEAS | LOCAL
  status            String    @default("ENQUIRY") // ENQUIRY | ORDERED | IN_PRODUCTION | SHIPPED | DELIVERED | CANCELLED
  reference         String?   // purchase order / order number
  itemDescription   String
  quantity          Float     @default(1)
  unitCostCents     Int       @default(0) // in `currency`, excludes shipping/customs/inspection
  currency          String    @default("AUD") // ISO 4217 code, e.g. AUD, USD, CNY
  /// Multiply an amount in `currency` by this to estimate its value in AUD. Only used (and only
  /// meaningful) when currency isn't AUD; null means no conversion has been recorded yet.
  exchangeRateToAud Float?
  /// Target GROSS margin (not markup) used to recommend a selling price: price = cost per unit ÷ (1 − margin).
  /// 0 ≤ value < 100. Existing records get the 40% default when the column is added.
  targetMarginPercent Float @default(40)
  orderDate         DateTime?
  expectedDate      DateTime? // expected ready/delivery date
  deliveredDate     DateTime?

  // Supplier / manufacturer. `supplierId` links to the Contacts book (the one source of truth).
  // The text fields below are the details as they were when the order was saved — kept so
  // history is never lost; when supplierId is set the Contact is what the app shows and keeps current.
  supplierId          String?
  supplier            Contact? @relation("OrderSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName        String
  supplierCountry     String?
  supplierContactName String?
  supplierEmail       String?
  supplierPhone       String?
  supplierWebsite     String?
  supplierAddress     String?

  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    SourcingPayment[]
  inspections SourcingInspection[]
  shipments   SourcingShipment[]
  documents   Document[]

  @@index([householdId])
  @@index([householdId, status])
  @@index([householdId, origin])
  @@index([householdId, orderDate])
  @@index([productId])
  @@index([supplierId])
}

/// A payment made towards a sourcing order — orders are often paid in stages
/// (e.g. deposit, then balance before shipment), so this is one-to-many rather
/// than the single paidDate/status pair used on BusinessEntry.
model SourcingPayment {
  id               String         @id @default(cuid())
  sourcingRecordId String
  sourcingRecord   SourcingRecord @relation(fields: [sourcingRecordId], references: [id], onDelete: Cascade)
  date             DateTime
  amountCents      Int            // in the order's currency — what goes to the supplier
  /// Bank / card / transfer fee charged on top of the payment. Not part of `amountCents` (it doesn't
  /// reduce what's owed to the supplier) but it is an extra cost of the order, so it adds to the total.
  feeCents         Int            @default(0)
  type             String         @default("DEPOSIT") // DEPOSIT | PROGRESS | BALANCE | FULL | OTHER
  method           String?        // BANK_TRANSFER | CREDIT_CARD | PAYPAL | CASH | OTHER
  bankAccountId    String?
  bankAccount      LedgerAccount? @relation(fields: [bankAccountId], references: [id])
  reference        String?        // bank reference / transaction id
  notes            String?
  /// Who was paid, when it isn't simply the order's supplier (e.g. a freight forwarder's invoice). Optional.
  contactId        String?
  contact          Contact?       @relation("PaymentContact", fields: [contactId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  /// Supplier invoices/receipts attached to this specific payment (optional).
  documents        Document[]

  @@index([sourcingRecordId])
  @@index([bankAccountId])
  @@index([contactId])
}

/// A quality-control / inspection cost incurred for a sourcing order (e.g. a third-party
/// inspection agency checking goods before they ship).
model SourcingInspection {
  id               String         @id @default(cuid())
  sourcingRecordId String
  sourcingRecord   SourcingRecord @relation(fields: [sourcingRecordId], references: [id], onDelete: Cascade)
  date             DateTime
  inspector        String?        // inspection company / person, as typed (kept for history)
  inspectorId      String?        // the inspection company in Contacts, when one was picked
  inspectorContact Contact?       @relation("InspectionContact", fields: [inspectorId], references: [id], onDelete: SetNull)
  result           String         @default("PENDING") // PENDING | PASSED | FAILED | PASSED_WITH_NOTES
  costCents        Int            @default(0) // in the order's currency
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([sourcingRecordId])
  @@index([inspectorId])
}

/// Shipping / freight financial details for a sourcing order. Split out from the order
/// itself since a single order can ship in more than one shipment.
model SourcingShipment {
  id                  String         @id @default(cuid())
  sourcingRecordId    String
  sourcingRecord      SourcingRecord @relation(fields: [sourcingRecordId], references: [id], onDelete: Cascade)
  method              String?        // SEA | AIR | COURIER | ROAD | OTHER
  carrier             String?        // carrier / forwarder as typed (kept for history)
  /// Contacts-book links. All optional; each is matched to the contact types that make sense for it in the UI.
  forwarderId         String?
  forwarder           Contact?       @relation("ShipmentForwarder", fields: [forwarderId], references: [id], onDelete: SetNull)
  customsAgentId      String?
  customsAgent        Contact?       @relation("ShipmentCustomsAgent", fields: [customsAgentId], references: [id], onDelete: SetNull)
  logisticsId         String?
  logistics           Contact?       @relation("ShipmentLogistics", fields: [logisticsId], references: [id], onDelete: SetNull)
  warehouseId         String?
  warehouse           Contact?       @relation("ShipmentWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  trackingNumber      String?
  shippedDate         DateTime?
  eta                 DateTime?
  arrivedDate         DateTime?
  freightCostCents    Int            @default(0) // in the order's currency
  customsDutyCents    Int            @default(0)
  insuranceCostCents  Int            @default(0)
  otherCostCents      Int            @default(0)
  notes               String?
  createdAt           DateTime       @default(now())

  /// Shipping paperwork (e.g. freight invoice, customs docs) attached to this specific shipment (optional).
  documents           Document[]

  @@index([sourcingRecordId])
  @@index([forwarderId])
  @@index([customsAgentId])
  @@index([logisticsId])
  @@index([warehouseId])
}

// ---------------------------------------------------------------------------
// Contacts (Company Finance): one place to keep the businesses you deal with —
// suppliers/manufacturers, freight forwarders, inspectors, customs agents,
// warehouses, customers — so they are entered once and picked everywhere else.
// A Contact is the ORGANISATION (so one company that is both supplier and
// manufacturer is a single record with several types); the individual people
// at it are ContactPerson rows. Records that used to carry the business's name
// as free text now also point at the Contact; the old text is kept for history.
// ---------------------------------------------------------------------------

/// A business or organisation Company Finance deals with.
model Contact {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String    // business / company name
  /// Comma-wrapped list of contact types, e.g. ",SUPPLIER_MANUFACTURER,FREIGHT_FORWARDER," (see CONTACT_TYPES).
  /// Stored as text so it stays portable between Postgres and SQLite; the wrapping commas make an exact-type match a plain `contains`.
  types       String    @default(",OTHER,")
  /// Lower-cased, whitespace-collapsed name — used to spot duplicates ("ABC Manufacturing Co Ltd" vs "abc  manufacturing co ltd").
  nameKey     String

  country     String?
  state       String?
  city        String?
  address     String?
  website     String?

  email       String?
  phone       String?
  mobile      String?
  whatsapp    String?
  wechat      String?
  otherContact String?  // any other messaging/contact method (free text)

  abn                String?
  registrationNumber String?
  taxNumber          String?  // VAT / GST / tax ID for overseas businesses
  paymentTerms       String?
  currency           String?  // usual currency, ISO 4217
  notes              String?

  isArchived  Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  people ContactPerson[]

  orders            SourcingRecord[]     @relation("OrderSupplier")
  payments          SourcingPayment[]    @relation("PaymentContact")
  inspections       SourcingInspection[] @relation("InspectionContact")
  forwarderShipments  SourcingShipment[] @relation("ShipmentForwarder")
  customsShipments    SourcingShipment[] @relation("ShipmentCustomsAgent")
  logisticsShipments  SourcingShipment[] @relation("ShipmentLogistics")
  warehouseShipments  SourcingShipment[] @relation("ShipmentWarehouse")
  entries           BusinessEntry[]

  @@index([householdId, isArchived])
  @@index([householdId, nameKey])
}

/// An individual at a Contact's organisation (sales, accounts, logistics…).
model ContactPerson {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?
  mobile    String?
  whatsapp  String?
  wechat    String?
  notes     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Holiday planner (Personal Finance): a trip with a budget, its expenses (each
// optionally with a payment due date) and a checklist of dated milestones
// (book flights, renew passport…). Money is in AUD dollars as Float, matching
// Bill and Transaction. The timeline the person sees is built on read from
// the trip dates, milestones and expense due dates — it isn't stored.
// ---------------------------------------------------------------------------

model HolidayPlan {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  destination String?
  status      String    @default("PLANNING") // IDEA | PLANNING | BOOKED | COMPLETED | CANCELLED
  startDate   DateTime?
  endDate     DateTime?
  travellers  Int       @default(1)
  budget      Float?    // overall spending limit, AUD
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses   HolidayExpense[]
  milestones HolidayMilestone[]

  @@index([householdId])
  @@index([householdId, startDate])
}

model HolidayExpense {
  id              String      @id @default(cuid())
  holidayPlanId   String
  holidayPlan     HolidayPlan @relation(fields: [holidayPlanId], references: [id], onDelete: Cascade)
  category        String      // FLIGHTS | ACCOMMODATION | TRANSPORT | FOOD | ACTIVITIES | INSURANCE | VISAS | SHOPPING | SPENDING_MONEY | OTHER
  description     String
  estimatedAmount Float       @default(0)
  /// The real cost once known (a quote or invoice). Until then the estimate is used.
  actualAmount    Float?
  dueDate         DateTime?   // when it has to be paid by
  paidDate        DateTime?   // set once paid
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([holidayPlanId])
}

model HolidayMilestone {
  id            String      @id @default(cuid())
  holidayPlanId String
  holidayPlan   HolidayPlan @relation(fields: [holidayPlanId], references: [id], onDelete: Cascade)
  title         String
  type          String      @default("OTHER") // BOOKING | DOCUMENTS | INSURANCE | PACKING | OTHER
  date          DateTime
  done          Boolean     @default(false)
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([holidayPlanId])
}
