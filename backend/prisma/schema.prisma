// Revenue Expense Tracker — database schema
//
// Production (Vercel): PostgreSQL, e.g. Neon (https://neon.tech) — Vercel's
// recommended serverless-friendly Postgres provider. `url` should be Neon's
// *pooled* connection string (via PgBouncer) since serverless functions can
// open many concurrent short-lived connections; `directUrl` should be the
// *unpooled* connection string, used only for running migrations.
//
// Local development: this same schema works with SQLite by temporarily
// setting `provider = "sqlite"` and `url = env("DATABASE_URL")` (see
// backend/.env.example) — no `directUrl` needed for SQLite.
//
// String "enum-like" fields are validated in the application layer (see
// src/lib/constants.ts) rather than as native Prisma enums, which keeps the
// schema portable between SQLite and PostgreSQL.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local development; "rhel-openssl-3.0.x" is required for
  // Vercel's Node.js serverless runtime (Amazon Linux 2023 + OpenSSL 3).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// People & households
// ---------------------------------------------------------------------------

/// A household is one "portfolio": a separate set of accounts, transactions,
/// properties, investments, bills… A person can belong to several (e.g. their
/// own finances plus a company and a trust) via PortfolioMember.
model Household {
  id            String   @id @default(cuid())
  name          String
  portfolioType String   @default("PERSONAL") // PERSONAL | COMPANY | TRUST | OTHER
  /// false only between registering and finishing the setup page; lets the setup
  /// page choose the type of a brand-new portfolio but never re-type an established one.
  setupComplete Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members          User[]
  portfolioMembers PortfolioMember[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  properties    Property[]
  investments   Investment[]
  bills         Bill[]
  reminders     Reminder[]
  documents     Document[]
  capitalGainDisposals CapitalGainDisposal[]
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  householdId     String?
  household       Household? @relation(fields: [householdId], references: [id])
  householdRole   String   @default("PRIMARY") // PRIMARY | PARTNER
  easyViewEnabled Boolean  @default(false)
  timezone        String   @default("Australia/Melbourne")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  portfolios         PortfolioMember[]
  transactions       Transaction[]
  propertyOwnerships PropertyOwnership[]
  notifications      Notification[]
  passwordResets     PasswordResetToken[]

  @@index([householdId])
}

/// Which portfolios (households) a person can open. `User.householdId` is their
/// default one; this table lists all of them, including the default.
model PortfolioMember {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role        String    @default("PRIMARY") // PRIMARY | PARTNER
  createdAt   DateTime  @default(now())

  @@unique([userId, householdId])
  @@index([householdId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Money: accounts, categories, transactions
// ---------------------------------------------------------------------------

model Account {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  type        String   // BANK | OFFSET | CREDIT_CARD | CASH | OTHER
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  bills        Bill[]

  @@index([householdId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  direction   String   // INCOME | EXPENSE
  isCustom    Boolean  @default(false)
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])
  createdAt   DateTime @default(now())

  transactions  Transaction[]
  bills         Bill[]
  scheduleLines PropertyScheduleLine[]

  @@index([householdId])
}

model Transaction {
  id                   String   @id @default(cuid())
  householdId          String
  household            Household @relation(fields: [householdId], references: [id])
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  date                 DateTime
  description          String
  amount               Float    // always positive; direction determines sign
  direction            String   // INCOME | EXPENSE
  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id])
  accountId            String?
  account              Account? @relation(fields: [accountId], references: [id])
  propertyId           String?
  property             Property? @relation(fields: [propertyId], references: [id])
  investmentId         String?
  investment           Investment? @relation(fields: [investmentId], references: [id])
  notes                String?
  isRecurring          Boolean  @default(false)
  recurrenceFrequency  String?  // WEEKLY | FORTNIGHTLY | MONTHLY | QUARTERLY | HALF_YEARLY | ANNUALLY | CUSTOM
  potentialTaxCategory String?  // suggestion only — never a determination
  financialYear        String   // e.g. "2026-27"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  documents Document[]
  reminders Reminder[]

  @@index([householdId])
  @@index([userId])
  @@index([date])
  @@index([financialYear])
  @@index([categoryId])
  @@index([propertyId])
  @@index([investmentId])
}

// ---------------------------------------------------------------------------
// Property investment
// ---------------------------------------------------------------------------

model Property {
  id                     String   @id @default(cuid())
  householdId            String
  household              Household @relation(fields: [householdId], references: [id])
  name                   String
  address                String?
  propertyType           String   @default("INVESTMENT") // INVESTMENT | PPR (principal place of residence)
  purchaseDate           DateTime?
  purchasePrice          Float?
  currentEstimatedValue  Float?
  loanBalance            Float?
  loanInterestRate       Float?
  rentalAgent            String?
  tenantName             String?
  rentAmount             Float?
  rentFrequency          String?  // WEEKLY | FORTNIGHTLY | MONTHLY
  rentalStartDate        DateTime?
  availableForRentDate   DateTime? // date the property was first genuinely available for rent
  scheduleInitialised    Boolean  @default(false) // default rental-schedule lines have been added
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  owners        PropertyOwnership[]
  transactions  Transaction[]
  bills         Bill[]
  documents     Document[]
  scheduleLines PropertyScheduleLine[]
  yearDetails   PropertyYearDetail[]

  @@index([householdId])
}

model PropertyOwnership {
  id         String @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  percentage Float    // 0-100

  @@unique([propertyId, userId])
}

/// One row of a property's rental income & expenses schedule. Each line points
/// at a category, so transactions recorded against the property in that
/// category roll up into the line. The list is configurable per property:
/// lines can be added or removed at any time (removing a line never deletes
/// transactions).
model PropertyScheduleLine {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  label      String?  // display name; falls back to the category name
  isManual   Boolean  @default(false) // amount is worked out elsewhere (e.g. depreciation schedule) and entered by hand
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([propertyId, categoryId])
  @@index([propertyId])
}

/// Per-financial-year rental facts for a property.
model PropertyYearDetail {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  financialYear String   // e.g. "2026-27"
  weeksRented   Int?
  updatedAt     DateTime @updatedAt

  @@unique([propertyId, financialYear])
}

// ---------------------------------------------------------------------------
// Shares, ETFs & other investments
// ---------------------------------------------------------------------------

model Investment {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  ticker      String?
  type        String   // SHARE | ETF | LIC | MANAGED_FUND | BOND | TERM_DEPOSIT | CRYPTO | P2P | PRIVATE | COLLECTIBLE | OTHER
  notes       String?
  currentValueOverride Float? // manual override for hard-to-price assets
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  investmentTransactions InvestmentTransaction[]
  dividends              Dividend[]
  transactions           Transaction[]
  documents              Document[]
  capitalGainDisposals   CapitalGainDisposal[]

  @@index([householdId])
}

model InvestmentTransaction {
  id           String   @id @default(cuid())
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id])
  type         String   // BUY | SELL
  date         DateTime
  quantity     Float
  pricePerUnit Float
  brokerage    Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([investmentId])
  @@index([date])
}

model Dividend {
  id              String   @id @default(cuid())
  investmentId    String
  investment      Investment @relation(fields: [investmentId], references: [id])
  exDividendDate  DateTime?
  paymentDate     DateTime?
  grossAmount     Float
  frankingCredit  Float    @default(0)
  frankedAmount   Float    @default(0)
  unfrankedAmount Float    @default(0)
  taxWithheld     Float    @default(0)
  netAmount       Float
  status          String   @default("EXPECTED") // EXPECTED | RECEIVED
  notes           String?
  financialYear   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents Document[]

  @@index([investmentId])
  @@index([financialYear])
}

/// A manually recorded capital gains disposal — for assets not tracked via
/// InvestmentTransaction buy/sell rows (e.g. a private sale, a collectible,
/// or a holding bought before you started using this app). Persisted so it
/// shows up in the Capital Gains report and tax summary alongside disposals
/// calculated automatically from buy/sell history.
model CapitalGainDisposal {
  id                  String   @id @default(cuid())
  householdId         String
  household           Household @relation(fields: [householdId], references: [id])
  investmentId        String
  investment          Investment @relation(fields: [investmentId], references: [id])
  purchaseDate        DateTime
  purchasePrice       Float
  purchaseCosts       Float    @default(0)
  saleDate            DateTime
  salePrice           Float
  saleCosts           Float    @default(0)
  quantity            Float
  ownershipPercentage Float    @default(100)
  costBase            Float
  proceeds            Float
  grossGainLoss       Float
  holdingPeriodDays   Int
  financialYear       String
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  documents Document[]

  @@index([householdId])
  @@index([investmentId])
  @@index([financialYear])
}

// ---------------------------------------------------------------------------
// Bills & reminders
// ---------------------------------------------------------------------------

model Bill {
  id                 String   @id @default(cuid())
  householdId        String
  household          Household @relation(fields: [householdId], references: [id])
  name               String
  provider           String?
  amount             Float
  frequency          String   // WEEKLY | FORTNIGHTLY | MONTHLY | QUARTERLY | HALF_YEARLY | ANNUALLY | CUSTOM
  nextDueDate        DateTime
  accountId          String?
  account            Account? @relation(fields: [accountId], references: [id])
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])
  propertyId         String?
  property           Property? @relation(fields: [propertyId], references: [id])
  autoRenew          Boolean  @default(false)
  reminderDaysBefore Int      @default(7)
  status             String   @default("UPCOMING") // UPCOMING | PAID | OVERDUE
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reminders Reminder[]

  @@index([householdId])
  @@index([nextDueDate])
}

model Reminder {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  billId      String?
  bill        Bill?    @relation(fields: [billId], references: [id])
  dividendId  String?
  /// Set for reminders created automatically from an expense dated in the future.
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  daysBefore  Int
  status      String   @default("PENDING") // PENDING | SNOOZED | COMPLETE | DISABLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([householdId])
  @@index([dueDate])
  @@index([transactionId])
}

// ---------------------------------------------------------------------------
// Documents & notifications
// ---------------------------------------------------------------------------

model Document {
  id            String   @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  fileName      String
  fileType      String
  filePath      String
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id])
  investmentId  String?
  investment    Investment? @relation(fields: [investmentId], references: [id])
  dividendId    String?
  dividend      Dividend? @relation(fields: [dividendId], references: [id])
  capitalGainDisposalId String?
  capitalGainDisposal   CapitalGainDisposal? @relation(fields: [capitalGainDisposalId], references: [id])
  createdAt     DateTime @default(now())

  @@index([householdId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
